{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/css/(.*)", "destination": "/packages/css/$1" },
    { "source": "/js/(.*)", "destination": "/packages/js/$1" },
    { "source": "/images/(.*)", "destination": "/packages/images/$1" },
    { "source": "/samples/(.*)", "destination": "/packages/samples/$1" },
    { "source": "/posters/(.*)", "destination": "/packages/posters/$1" },
    { "source": "/apple/(.*)", "destination": "/packages/apple/$1" },

    { "source": "/qr-poster", "destination": "/packages/qr-poster.html" },
    { "source": "/packages/qr-poster", "destination": "/packages/qr-poster.html" },

    { "source": "/events", "destination": "/events/index.html" },
    { "source": "/events/", "destination": "/events/index.html" },
    { "source": "/events/index", "destination": "/events/index.html" },
    { "source": "/events/index.html", "destination": "/events/index.html" },
    { "source": "/laureighn-events", "destination": "/events/index.html" },
    { "source": "/laureighn-events/", "destination": "/events/index.html" },
    { "source": "/laureign-events", "destination": "/events/index.html" },
    { "source": "/laureign-events/", "destination": "/events/index.html" },
    { "source": "/events/css/(.*)", "destination": "/events/css/$1" },
    { "source": "/events/js/(.*)", "destination": "/events/js/$1" },
    { "source": "/events/(.*)", "destination": "/events/$1" },

    { "source": "/", "destination": "/packages/index.html" },
    { "source": "/packages", "destination": "/packages/index.html" },
    { "source": "/packages/", "destination": "/packages/index.html" },
    { "source": "/index", "destination": "/packages/index.html" },
    { "source": "/index.html", "destination": "/packages/index.html" },
    { "source": "/packages/index", "destination": "/packages/index.html" },
    { "source": "/packages/index.html", "destination": "/packages/index.html" },

    { "source": "/packages/:page.html", "destination": "/packages/:page.html" },
    { "source": "/packages/:page", "destination": "/packages/:page.html" },
    { "source": "/:page.html", "destination": "/packages/:page.html" },
    { "source": "/:page", "destination": "/packages/:page.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(packages/)?css/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(packages/)?js/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/packages/(samples|images|posters|apple)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(samples|images|posters|apple)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, stale-while-revalidate=86400" }
      ]
    }
  ]
}
